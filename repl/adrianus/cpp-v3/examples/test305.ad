// data types bootstrap tests

stack = _AdDataTypeStack()
stack.push(1)
stack.push(2)
stack.push(3)
println(stack.toString())
println(stack.pop())
println(stack.peek())
println(stack.is_empty())
println(stack.toString())

queue = _AdDataTypeQueue()
queue.enqueue(1)
queue.enqueue(2)
queue.enqueue(3)
println(queue.toString())
println(queue.dequeue())
println(queue.peek())
println(queue.is_empty())
println(queue.toString())