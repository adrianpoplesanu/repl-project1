class _AdAlgos_InsertionSort {
    def sort(arr) {
        for (i = 1; i < len(arr); i++) {
            key = arr[i]
            j = i - 1
            while (j >= 0 and key < arr[j]) {
                tmp = arr[j + 1]
                arr[j + 1] = arr[j]
                arr[j] = tmp
                j -= 1
            }
        }
    }
}

class _AdAlgos_BubbleSort {
    def sort(arr) {
        for (i = 0; i < len(arr); i++) {
            for (j = 0; j < len(arr) - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    tmp = arr[j]
                    arr[j] = arr[j + 1]
                    arr[j + 1] = tmp
                }
            }
        }
    }
}

class _AdAlgos_MinSort {
    def sort(arr) {
        for (i = 0; i < len(arr); i++) {
            minIndex = i
            for (j = i + 1; j < len(arr); j++) {
                if (arr[j] < arr[minIndex]) {
                    minIndex = j
                }
            }
            tmp = arr[i]
            arr[i] = arr[minIndex]
            arr[minIndex] = tmp
        }
    }
}

class _AdAlgos_MaxSort {
    def sort(arr) {
        for (i = 0; i < len(arr); i++) {
            maxIndex = 0
            for (j = 0; j < len(arr) - i; j++) {
                if (arr[j] > arr[maxIndex]) {
                    maxIndex = j
                }
            }
            tmp = arr[len(arr) - i - 1]
            arr[len(arr) - i - 1] = arr[maxIndex]
            arr[maxIndex] = tmp
        }
    }
}

