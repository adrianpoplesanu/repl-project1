class _AdAlgos_InsertionSort {
    def sort(arr) {
        for (i = 1; i < len(arr); i++) {
            key = arr[i]
            j = i - 1
            while (j >= 0 and key < arr[j]) {
                tmp = arr[j + 1]
                arr[j + 1] = arr[j]
                arr[j] = tmp
                j -= 1
            }
        }
    }
}

class _AdAlgos_BubbleSort {
    def sort(arr) {
        for (i = 0; i < len(arr); i++) {
            for (j = 0; j < len(arr) - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    tmp = arr[j]
                    arr[j] = arr[j + 1]
                    arr[j + 1] = tmp
                }
            }
        }
    }
}

class _AdAlgos_MinSort {
    def sort(arr) {
        for (i = 0; i < len(arr); i++) {
            minIndex = i
            for (j = i + 1; j < len(arr); j++) {
                if (arr[j] < arr[minIndex]) {
                    minIndex = j
                }
            }
            tmp = arr[i]
            arr[i] = arr[minIndex]
            arr[minIndex] = tmp
        }
    }
}

class _AdAlgos_MaxSort {
    def sort(arr) {
        for (i = 0; i < len(arr); i++) {
            maxIndex = 0
            for (j = 0; j < len(arr) - i; j++) {
                if (arr[j] > arr[maxIndex]) {
                    maxIndex = j
                }
            }
            tmp = arr[len(arr) - i - 1]
            arr[len(arr) - i - 1] = arr[maxIndex]
            arr[maxIndex] = tmp
        }
    }
}

class _AdAlgos_MergeSort {
    L = []

    def merge(a, left, mid, right) {
        i = left
        k = left
        j = mid + 1
        while(i <= mid and j <= right) {
            if(a[i] < a[j]) {
                L[k] = a[i]
                i++
                k++
            } else {
                L[k] = a[j]
                j++
                k++
            }
        }
        while(i <= mid) {
            L[k] = a[i]
            i++
            k++
        }
        while(j <= right) {
            L[k] = a[j]
            j++
            k++
        }
        for(k = left; k <= right; k++) {
            a[k] = L[k]
        }
    }

    def mergeSort(a, left, right) {
        if (left < right) {
            mid = left + (right - left) / 2
            mergeSort(a, left, mid)
            mergeSort(a, mid + 1, right)
            merge(a, left, mid, right)
        }
    }

    def sort(a) {
        L = list(len(a), 0)
        mergeSort(a, 0, len(a) - 1)
    }
}

class _AdAlgos_QuickSort {
    def sort(a) {
        quickSort(a, 0, len(a) - 1)
    }

    def partition(a, left, right) {
        pivot = a[right]
        i = left - 1
        for (j = left; j < right; j++) {
            if (a[j] < pivot) {
                i++
                tmp = a[i]
                a[i] = a[j]
                a[j] = tmp
            }
        }
        tmp = a[i + 1]
        a[i + 1] = a[right]
        a[right] = tmp
        return i + 1
    }

    def quickSort(a, left, right) {
        if (left < right) {
            pivot = partition(a, left, right)
            quickSort(a, left, pivot - 1)
            quickSort(a, pivot + 1, right)
        }
    }
}

class _AdAlgos_CountingSort {

    def max(a) {
        answer = a[0]
        for (i = 1; i < len(a); i++) {
            if (a[i] > answer) {
                answer = a[i]
            }
        }
        return answer
    }

    def sort(a) {
        max_value = max(a)
        count = list(max_value + 1, 0)
        for (i = 0; i < len(a); i++) {
            count[a[i]]++
        }
        for (i = 1; i <= max_value; i++) {
            count[i] += count[i - 1]
        }
        output = list(len(a), 0)
        for (i = len(a) - 1; i >= 0; i--) {
            output[count[a[i]] - 1] = a[i]
            count[a[i]]--
        }
        for (i = 0; i < len(a); i++) {
            a[i] = output[i]
        }
    }
}

