  curl localhost:5005/
  curl "localhost:5005/echo?user=a&role=admin"

POST:
  curl --header "Content-Type: application/json" \
    --request POST \
    --data '{"username":"xyz","password":"xyz"}' \
    http://localhost:5005/api/login

404:
  curl localhost:5005/missing

Check port:
  lsof -nP -iTCP:5005 -sTCP:LISTEN 2>/dev/null || echo "nothing listening on 5005"
*/
