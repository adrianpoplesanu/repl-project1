class _Requests {
    httpParser = null
    logger = null

    def constructor() {
        httpParser = AdHTTPParser()
        logger = AdLogger("BOOT", "requests")
    }

    def get(host=null, payload=null) {
        port = 80
        client = ClientSocket(host, port)
        req = "GET / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"
        //println(req)
        client.send(req) // combine this send and read in one method
        message = client.read()
        return message
    }

    def get2(host=null, payload=null) {
        port = 80
        valid = false
        if (StringUtils.startsWith(host, "http://")) {
            valid = true
        }
        if (StringUtils.startsWith(host, "https://")) {
            valid = true
            port = 443
        }
        if (!valid) {
            println("[ BOOT ][ request.get2 ] missing schema, maybe add http:// or https://")
            return null
        }
        client = ClientSocket(host, port)
        //req = "GET / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n" // this does not, domain needs to be extracted
        req = "GET / HTTP/1.1\r\nHost: adrianus.ro\r\nConnection: close\r\n\r\n" // this works
        //println(req)
        //println(type(client))
        message = client.sendAndReadBackHTTP(req)
        return message
    }

    def resolveUrl(url) {
        url_without_protocol = httpParser.removeProtocol(url)
        is_https_call = httpParser.isHTTPS(url)
        default_port = 80
        if (is_https_call) {
            default_port = 443
        }
        host = httpParser.getHost(url_without_protocol)
        port = httpParser.getPort(url_without_protocol, default_port)
        host_header = httpParser.getDomain(url_without_protocol)
        uri = httpParser.getUri(url_without_protocol)
        if (!StringUtils.startsWith(uri, "/")) {
            uri = "/" + uri
        }
        return {
            "host": host,
            "port": port,
            "host_header": host_header,
            "uri": uri,
            "https": is_https_call
        }
    }

    def sendRequest(host, port, is_https_call, request) {
        client = ClientSocket(host, port)
        if (is_https_call) {
            return client.sendAndReadBackHTTPS(request)
        }
        return client.sendAndReadBackHTTP(request)
    }

    def get3(url=null, payload=null, headers=null) {
        if (!httpParser.isValidHost(url)) {
            logger.error(url + " is missing schema, maybe add http:// or https://")
            return null
        }

        parts = this.resolveUrl(url)
        host = parts["host"]
        port = parts["port"]
        host_header = parts["host_header"]
        uri = parts["uri"]
        is_https_call = parts["https"]

        queryParams = ""
        if ((payload != null) and (type(payload) == "HASH")) {
            queryParams = httpParser.mapToQueryParams(payload)
        }

        request = "GET " + uri + " HTTP/1.1\r\nHost: " + host_header + "\r\nConnection: close\r\n\r\n"
        if (queryParams != "") {
            request = "GET " + uri + queryParams + " HTTP/1.1\r\nHost: " + host_header + "\r\nConnection: close\r\n\r\n"
        }

        return this.sendRequest(host, port, is_https_call, request)
    }

    def post(url=null, payload=null, headers=null) {
        if (!httpParser.isValidHost(url)) {
            logger.error(url + " is missing schema, maybe add http:// or https://")
            return null
        }

        parts = this.resolveUrl(url)
        host = parts["host"]
        port = parts["port"]
        host_header = parts["host_header"]
        uri = parts["uri"]
        is_https_call = parts["https"]

        queryParams = ""
        if ((payload != null) and (type(payload) == "HASH")) {
            queryParams = httpParser.mapToQueryParams(payload)
        }

        request = "POST " + uri + " HTTP/1.1\r\nHost: " + host_header + "\r\nConnection: close\r\n\r\n"
        if (queryParams != "") {
            request = "POST " + uri + queryParams + " HTTP/1.1\r\nHost: " + host_header + "\r\nConnection: close\r\n\r\n"
        }

        return this.sendRequest(host, port, is_https_call, request)
    }

    def postBody(url=null, body=null, content_type="application/json") {
        if (!httpParser.isValidHost(url)) {
            logger.error(url + " is missing schema, maybe add http:// or https://")
            return null
        }

        parts = this.resolveUrl(url)
        host = parts["host"]
        port = parts["port"]
        host_header = parts["host_header"]
        uri = parts["uri"]
        is_https_call = parts["https"]

        body_text = ""
        if (body != null) {
            body_text = body
        }
        if (content_type == null) {
            content_type = "application/json"
        }

        request = "POST " + uri + " HTTP/1.1\r\nHost: " + host_header + "\r\nContent-Type: " + content_type + "\r\nContent-Length: " + len(body_text) + "\r\nConnection: close\r\n\r\n" + body_text
        return this.sendRequest(host, port, is_https_call, request)
    }
}

requests = _Requests()
